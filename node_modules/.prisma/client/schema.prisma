datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  PLAYER
  COACH
  VENUE
  ORGANIZATION
  GUEST
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  CANCELLED
}

enum Rarity {
  COMMON
  UNCOMMON
  RARE
  LEGENDARY
  MYTHIC
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  username     String   @unique
  fullName     String
  role         Role     @default(PLAYER)
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  playerProfile PlayerProfile?
  venues        Venue[]        @relation("VenueOwner")
  matches       Match[]        @relation("MatchCreator")
  teams         Team[]         @relation("TeamCoach")
  tournaments   Tournament[]   @relation("OrgTournaments")
}

model PlayerProfile {
  id       String @id @default(uuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating   Int    @default(75)
  position String @default("DC")
  pac      Int    @default(80)
  sho      Int    @default(75)
  pas      Int    @default(70)
  dri      Int    @default(78)
  def      Int    @default(50)
  phy      Int    @default(72)
  rarity   Rarity @default(RARE)
  matches  Int    @default(0)
  goals    Int    @default(0)
  assists  Int    @default(0)
}

model Venue {
  id        String   @id @default(uuid())
  name      String
  address   String
  city      String   @default("Concepción")
  ownerId   String
  owner     User     @relation("VenueOwner", fields: [ownerId], references: [id])
  courts    Court[]
  createdAt DateTime @default(now())
}

model Court {
  id          String  @id @default(uuid())
  venueId     String
  venue       Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name        String
  surfaceType String  @default("Pasto Sintético")
  hasLighting Boolean @default(true)
  hourlyRate  Int     @default(35000)
  matches     Match[]
}

model Match {
  id          String      @id @default(uuid())
  title       String
  courtId     String
  court       Court       @relation(fields: [courtId], references: [id])
  creatorId   String
  creator     User        @relation("MatchCreator", fields: [creatorId], references: [id])
  date        String
  startTime   String
  endTime     String
  status      MatchStatus @default(SCHEDULED)
  homeScore   Int?
  awayScore   Int?
  pricePlayer Int         @default(3500)
  maxPlayers  Int         @default(14)
  createdAt   DateTime    @default(now())
}

model Team {
  id        String   @id @default(uuid())
  name      String
  badgeUrl  String?
  coachId   String?
  coach     User?    @relation("TeamCoach", fields: [coachId], references: [id])
  createdAt DateTime @default(now())
}

model Tournament {
  id        String   @id @default(uuid())
  name      String
  category  String   @default("Primera Infantil")
  orgId     String
  org       User     @relation("OrgTournaments", fields: [orgId], references: [id])
  status    String   @default("EN_DESARROLLO")
  createdAt DateTime @default(now())
}
