datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  PLAYER
  COACH
  VENUE
  ORGANIZATION
  GUEST
}

enum MatchStatus {
  DRAFT
  WAITING_PLAYERS
  CONFIRMED
  PENDING_VENUE
  READY
  LIVE
  PAUSED
  HALFTIME
  SUSPENDED
  FINISHED
  RATING_PHASE
  CLOSED
  CANCELLED
}

enum OfficialResultStatus {
  DRAFT
  PROVISIONAL
  FINALIZED
}

enum SuspensionReason {
  WEATHER
  NO_SHOW
  FIELD_ISSUE
  INCIDENT
  OTHER
}

enum Rarity {
  COMMON
  UNCOMMON
  RARE
  LEGENDARY
  MYTHIC
}

model User {
  id                String              @id @default(uuid())
  email             String              @unique
  passwordHash      String
  username          String              @unique
  fullName          String
  role              Role                @default(PLAYER)
  avatarUrl         String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  playerProfile     PlayerProfile?
  venues            Venue[]             @relation("VenueOwner")
  matches           Match[]             @relation("MatchCreator")
  teams             Team[]              @relation("TeamCoach")
  organizationStaff OrganizationStaff[]
  officialResults   OfficialResult[]    @relation("FinalizedBy")
  matchSuspensions  MatchSuspension[]   @relation("SuspendedBy")
  officialPlayerStats OfficialPlayerStats[]
}

model PlayerProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int      @default(75)
  position  String   @default("DC")
  pac       Int      @default(80)
  sho       Int      @default(75)
  pas       Int      @default(70)
  dri       Int      @default(78)
  def       Int      @default(50)
  phy       Int      @default(72)
  rarity    Rarity   @default(RARE)
  matches   Int      @default(0)
  goals     Int      @default(0)
  assists   Int      @default(0)
}

model Organization {
  id                 String              @id @default(uuid())
  name               String
  description        String?
  orgType            String              @default("amateur_league")
  legalId            String?
  address            String?
  phone              String?
  email              String?
  logoUrl            String?
  status             String              @default("active")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  staff              OrganizationStaff[]
  venues             OrganizationVenue[]
  tournaments        Tournament[]
  teamInvitations    TeamInvitation[]
}

model OrganizationStaff {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("admin") // owner, admin, staff
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
}

model Venue {
  id           String              @id @default(uuid())
  name         String
  address      String
  city         String              @default("Concepción")
  ownerId      String
  owner        User                @relation("VenueOwner", fields: [ownerId], references: [id])
  courts       Court[]
  orgVenues    OrganizationVenue[]
  fixtures     Fixture[]
  createdAt    DateTime            @default(now())
}

model OrganizationVenue {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  venueId        String
  venue          Venue        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  status         String       @default("active")
  createdAt      DateTime     @default(now())

  @@unique([organizationId, venueId])
}

model Court {
  id          String   @id @default(uuid())
  venueId     String
  venue       Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name        String
  surfaceType String   @default("Pasto Sintético")
  hasLighting Boolean  @default(true)
  hourlyRate  Int      @default(35000)
  matches     Match[]
}

model Match {
  id          String            @id @default(uuid())
  title       String
  courtId     String
  court       Court             @relation(fields: [courtId], references: [id])
  creatorId   String
  creator     User              @relation("MatchCreator", fields: [creatorId], references: [id])
  date        String
  startTime   String
  endTime     String
  status      MatchStatus       @default(READY)
  pricePlayer Int               @default(3500)
  maxPlayers  Int               @default(14)
  createdAt   DateTime          @default(now())

  fixtures    Fixture[]
  officialResult OfficialResult?
  suspension  MatchSuspension?
}

model Team {
  id                 String                @id @default(uuid())
  name               String
  badgeUrl           String?
  coachId            String?
  coach              User?                 @relation("TeamCoach", fields: [coachId], references: [id])
  createdAt          DateTime              @default(now())

  invitations        TeamInvitation[]
  homeFixtures       Fixture[]             @relation("HomeTeam")
  awayFixtures       Fixture[]             @relation("AwayTeam")
  officialTeamStats  OfficialTeamStats[]
  officialPlayerStats OfficialPlayerStats[]
}

model Tournament {
  id                 String                @id @default(uuid())
  name               String
  category           String                @default("Primera Infantil")
  organizationId     String
  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status             String                @default("active")
  createdAt          DateTime              @default(now())

  rounds             FixtureRound[]
  fixtures           Fixture[]
  invitations        TeamInvitation[]
  officialResults    OfficialResult[]
  officialPlayerStats OfficialPlayerStats[]
  officialTeamStats  OfficialTeamStats[]
}

model TeamInvitation {
  id             String       @id @default(uuid())
  tournamentId   String
  tournament     Tournament   @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teamId         String
  team           Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  status         String       @default("pending") // pending, accepted, rejected, expired
  createdAt      DateTime     @default(now())

  @@unique([tournamentId, teamId])
}

model FixtureRound {
  id            String     @id @default(uuid())
  tournamentId  String
  tournament    Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  roundNumber   Int
  name          String     @default("Jornada 1")
  status        String     @default("upcoming")

  fixtures      Fixture[]

  @@unique([tournamentId, roundNumber])
}

model Fixture {
  id             String       @id @default(uuid())
  tournamentId   String
  tournament     Tournament   @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  fixtureRoundId String
  fixtureRound   FixtureRound @relation(fields: [fixtureRoundId], references: [id], onDelete: Cascade)
  homeTeamId     String
  homeTeam       Team         @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId     String
  awayTeam       Team         @relation("AwayTeam", fields: [awayTeamId], references: [id])
  venueId        String?
  venue          Venue?       @relation(fields: [venueId], references: [id])
  matchId        String?
  match          Match?       @relation(fields: [matchId], references: [id])
  scheduledDate  String
  status         String       @default("scheduled")
  createdAt      DateTime     @default(now())
}

model OfficialResult {
  id           String               @id @default(uuid())
  matchId      String               @unique
  match        Match                @relation(fields: [matchId], references: [id], onDelete: Cascade)
  tournamentId String
  tournament   Tournament           @relation(fields: [tournamentId], references: [id])
  homeScore    Int                  @default(0)
  awayScore    Int                  @default(0)
  status       OfficialResultStatus @default(DRAFT)
  refereeName  String?
  refereeNotes String?
  finalizedById String?
  finalizedBy  User?                @relation("FinalizedBy", fields: [finalizedById], references: [id])
  publishedAt  DateTime?
  finalizedAt  DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model MatchSuspension {
  id           String           @id @default(uuid())
  matchId      String           @unique
  match        Match            @relation(fields: [matchId], references: [id], onDelete: Cascade)
  suspendedById String
  suspendedBy  User             @relation("SuspendedBy", fields: [suspendedById], references: [id])
  reason       SuspensionReason @default(WEATHER)
  notes        String?
  status       String           @default("active")
  createdAt    DateTime         @default(now())
}

model OfficialPlayerStats {
  id            String     @id @default(uuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournamentId  String
  tournament    Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teamId        String
  team          Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  matchesPlayed Int        @default(0)
  goals         Int        @default(0)
  assists       Int        @default(0)
  yellowCards   Int        @default(0)
  redCards      Int        @default(0)
  updatedAt     DateTime   @updatedAt

  @@unique([userId, tournamentId])
}

model OfficialTeamStats {
  id            String     @id @default(uuid())
  teamId        String
  team          Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  tournamentId  String
  tournament    Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  matchesPlayed Int        @default(0)
  wins          Int        @default(0)
  draws         Int        @default(0)
  losses        Int        @default(0)
  goalsFor      Int        @default(0)
  goalsAgainst  Int        @default(0)
  points        Int        @default(0)
  updatedAt     DateTime   @updatedAt

  @@unique([teamId, tournamentId])
}
